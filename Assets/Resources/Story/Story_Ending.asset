    speaker: "\u0E1E\u0E48\u0E2D"
    text: "\u201C\u0E23\u0E35\u0E1A\u0E2D\u0E2D\u0E01\u0E15\u0E32\u0E21\u0E17\u0E32\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E08\u0E31\u0E14\u0E01\u0E32\u0E23\u0E04\u0E19\u0E17\u0E35\u0E48\u0E1A\u0E07\u0E01\u0E32\u0E23\u0E2D\u0E22\u0E39\u0E48
