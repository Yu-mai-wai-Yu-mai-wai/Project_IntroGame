  m_Name: TutorialText
  m_EditorClassIdentifier: Assembly-CSharp::TawanOS.UI.TutorialTextSO
  enemyKhwan:
    title: "\u0E02\u0E27\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E28\u0E31\u0E15\u0E23\u0E39"
    body: "\u0E02\u0E27\u0E31\u0E0D\u0E40\u0E1B\u0E23\u0E35\u0E22\u0E1A\u0E40\u0E2A\u0E21\u0E37\u0E2D\u0E19\u0E1E\u0E25\u0E31\u0E07\u0E0A\u0E35\u0E27\u0E34\u0E15
      \u0E2B\u0E32\u0E01\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E02\u0E27\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E28\u0E31\u0E15\u0E23\u0E39\u0E40\u0E2B\u0E25\u0E37\u0E2D
      0 \u0E08\u0E30\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E0A\u0E31\u0E22\u0E0A\u0E19\u0E30"
  playerKhwan:
    title: "\u0E02\u0E27\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13"
    body: "\u0E43\u0E19\u0E17\u0E32\u0E07\u0E01\u0E25\u0E31\u0E1A\u0E01\u0E31\u0E19\u0E16\u0E49\u0E32\u0E02\u0E27\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13\u0E40\u0E2B\u0E25\u0E37\u0E41
      0 \u0E01\u0E48\u0E2D\u0E19 \u0E04\u0E38\u0E13\u0E08\u0E30\u0E41\u0E1E\u0E49"
  enemyFirst:
    title: "\u0E28\u0E31\u0E15\u0E23\u0E39\u0E25\u0E07\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E2A\u0E21\u0E2D"
    body: "\u0E17\u0E38\u0E01\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19 \u0E28\u0E31\u0E15\u0E23\u0E39\u0E08\u0E30\u0E25\u0E07\u0E1A\u0E23\u0E34\u0E27\u0E32\u0E23\u0E41\u0E25\u0E30\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E23\u0E32\u0E07\u0E43\u0E19\u0E2A\u0E19\u0E32\u0E21\u0E01\u0E48\u0E2D\u0E19"
  hand:
    title: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E43\u0E19\u0E21\u0E37\u0E2D"
    body: "\u0E43\u0E19\u0E41\u0E15\u0E48\u0E25\u0E30\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E40\u0E25\u0E48\u0E19\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E08\u0E32\u0E01\u0E1A\u0E19\u0E21\u0E37\u0E2D\u0E44\u0E14\u0E49\n\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E1A\u0E23\u0E34\u0E27\u0E32\u0E23\u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E23\u0E32\u0E07\u0E17\u0E35\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E08\u0E30\u0E40\u0E25\u0E48\u0E19\u0E44\u0E14\u0E49"
  board:
    title: "\u0E01\u0E23\u0E30\u0E14\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13"
    body: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E0A\u0E48\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E07\u0E17\u0E35\u0E48\u0E2A\u0E27\u0E48\u0E32\u0E07\u0E02\u0E36\u0E49\u0E19\u0E1A\u0E19\u0E01\u0E23\u0E30\u0E14\u0E32\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E25\u0E48\u0E19\u0E01\u0E32\u0E23\u0E4C\u0E14\n\u0E04\u0E25\u0E34\u0E01\u0E02\u0E27\u0E32\u0E2B\u0E23\u0E37\u0E2D\u0E01\u0E14
      Esc \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E22\u0E01\u0E40\u0E25\u0E34\u0E01\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E17\u0E35\u0E48\u0E40\u0E25\u0E37\u0E2D\u0E01
      (\u0E01\u0E48\u0E2D\u0E19\u0E27\u0E32\u0E07\u0E25\u0E07\u0E2A\u0E19\u0E32\u0E21)
      \u0E01\u0E32\u0E23\u0E4C\u0E14\u0E17\u0E35\u0E48\u0E27\u0E32\u0E07\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2D\u0E32\u0E04\u0E37\u0E19\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\n\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E25\u0E07\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E40\u0E2A\u0E23\u0E47\u0E08\u0E41\u0E25\u0E49\u0E27
      \u0E01\u0E14\u0E1B\u0E38\u0E48\u0E21\u0E08\u0E1A\u0E0A\u0E48\u0E27\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E08\u0E1A\u0E40\u0E1F\u0E2A"
  merit:
    title: "\u0E01\u0E38\u0E28\u0E25"
    body: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E21\u0E19\u0E15\u0E4C\u0E02\u0E32\u0E27\u0E43\u0E0A\u0E49\u0E01\u0E38\u0E28\u0E25\u0E43\u0E19\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E40\u0E25\u0E48\u0E19
      (\u0E14\u0E39\u0E44\u0E14\u0E49\u0E17\u0E35\u0E48\u0E21\u0E38\u0E21\u0E0B\u0E49\u0E32\u0E22\u0E1A\u0E19\u0E02\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E4C\u0E14)\n\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19\u0E41\u0E23\u0E01\u0E21\u0E35\u0E01\u0E38\u0E28\u0E25
      {first} \u0E41\u0E15\u0E49\u0E21 \u0E40\u0E1E\u0E34\u0E48\u0E21\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19\u0E25\u0E30
      1 \u0E41\u0E15\u0E49\u0E21 \u0E2A\u0E39\u0E07\u0E2A\u0E38\u0E14 {max} \u0E41\u0E15\u0E49\u0E21\n\u0E01\u0E38\u0E28\u0E25\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E43\u0E0A\u0E49\u0E08\u0E30\u0E44\u0E21\u0E48\u0E2A\u0E30\u0E2A\u0E21\u0E44\u0E1B\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19\u0E2B\u0E19\u0E49\u0E32"
  spell:
    title: "\u0E23\u0E48\u0E32\u0E22\u0E2D\u0E32\u0E04\u0E21"
    body: "\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E2D\u0E32\u0E04\u0E21\u0E2B\u0E32\u0E01\u0E2D\u0E32\u0E04\u0E21\u0E19\u0E31\u0E49\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22\n\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E04\u0E25\u0E34\u0E01\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22\u0E1A\u0E19\u0E01\u0E23\u0E30\u0E14\u0E32\u0E19\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22\n\u0E2A\u0E48\u0E27\u0E19\u0E2D\u0E32\u0E04\u0E21\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22
      \u0E04\u0E25\u0E34\u0E01\u0E17\u0E35\u0E48\u0E44\u0E2B\u0E19\u0E01\u0E47\u0E44\u0E14\u0E49\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E23\u0E48\u0E32\u0E22"
  clash:
    title: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E40\u0E02\u0E49\u0E32\u0E1B\u0E30\u0E17\u0E30\u0E01\u0E31\u0E19"
    body: "\u0E1A\u0E23\u0E34\u0E27\u0E32\u0E23\u0E15\u0E35\u0E01\u0E31\u0E19\u0E17\u0E35\u0E25\u0E30\u0E04\u0E39\u0E48
      \u0E08\u0E32\u0E01\u0E0B\u0E49\u0E32\u0E22\u0E44\u0E1B\u0E02\u0E27\u0E32\n\u0E2B\u0E32\u0E01\u0E0A\u0E48\u0E2D\u0E07\u0E15\u0E23\u0E07\u0E02\u0E49\u0E32\u0E21\u0E27\u0E48\u0E32\u0E07
      \u0E08\u0E30\u0E15\u0E35\u0E02\u0E27\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E1D\u0E48\u0E32\u0E22\u0E15\u0E23\u0E07\u0E02\u0E49\u0E32\u0E21\u0E42\u0E14\u0E22\u0E15\u0E23\u0E07"
  drawPile:
    title: "\u0E01\u0E2D\u0E07\u0E08\u0E31\u0E48\u0E27"
    body: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E17\u0E35\u0E48\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E08\u0E31\u0E48\u0E27\u0E08\u0E30\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48"
  graveyard:
    title: "\u0E2B\u0E25\u0E38\u0E21\u0E28\u0E1E"
    body: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E17\u0E35\u0E48\u0E43\u0E0A\u0E49\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27\u0E2B\u0E23\u0E37\u0E2D\u0E16\u0E39\u0E01\u0E17\u0E33\u0E25\u0E32\u0E22\u0E02\u0E2D\u0E07\u0E17\u0E31\u0E49\u0E07\u0E2A\u0E2D\u0E07\u0E1D\u0E48\u0E32\u0E22\u0E21\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48
      \n\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E04\u0E25\u0E34\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E14\u0E39\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E21\u0E14\u0E43\u0E19\u0E2B\u0E25\u0E38\u0E21\u0E28\u0E1E\u0E44\u0E14\u0E49"
  centerPit:
    title: "\u0E2B\u0E25\u0E38\u0E21\u0E01\u0E25\u0E32\u0E07"
    body: "\u0E17\u0E38\u0E01\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19\u0E08\u0E30\u0E21\u0E35\u0E01\u0E32\u0E23\u0E4C\u0E14
      4 \u0E43\u0E1A\u0E40\u0E1B\u0E34\u0E14\u0E2B\u0E19\u0E49\u0E32\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32\u0E08\u0E32\u0E01\u0E2B\u0E25\u0E38\u0E21\u0E01\u0E25\u0E32\u0E07
      \u0E04\u0E38\u0E13\u0E01\u0E31\u0E1A\u0E28\u0E31\u0E15\u0E23\u0E39\u0E44\u0E14\u0E49\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E04\u0E19\u0E25\u0E30
      1 \u0E43\u0E1A\n\u0E1D\u0E48\u0E32\u0E22\u0E17\u0E35\u0E48\u0E44\u0E14\u0E49\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E01\u0E48\u0E2D\u0E19\u0E2A\u0E25\u0E31\u0E1A\u0E01\u0E31\u0E19\u0E17\u0E38\u0E01\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19
      \u0E43\u0E1A\u0E17\u0E35\u0E48\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E08\u0E30\u0E16\u0E39\u0E01\u0E17\u0E34\u0E49\u0E07"
  inspect:
    title: "\u0E14\u0E39\u0E01\u0E32\u0E23\u0E4C\u0E14"
    body: "\u0E04\u0E25\u0E34\u0E01\u0E02\u0E27\u0E32\u0E17\u0E35\u0E48\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E43\u0E1A\u0E44\u0E2B\u0E19\u0E01\u0E47\u0E44\u0E14\u0E49\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E14\u0E39\u0E23\u0E32\u0E22\u0E25\u0E30\u0E40\u0E2D\u0E35\u0E22\u0E14\n\u0E41\u0E25\u0E30\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E01\u0E14
      W \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E14\u0E39\u0E01\u0E23\u0E30\u0E14\u0E32\u0E19\u0E08\u0E32\u0E01\u0E21\u0E38\u0E21\u0E1A\u0E19
      \u0E41\u0E25\u0E30\u0E01\u0E14 S \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E38\u0E21\u0E1B\u0E01\u0E15\u0E34"
  corruption:
    title: "\u0E21\u0E25\u0E17\u0E34\u0E19"
    body: "\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E21\u0E19\u0E15\u0E4C\u0E14\u0E33\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E49\u0E01\u0E38\u0E28\u0E25
      \u0E41\u0E15\u0E48\u0E08\u0E30\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E21\u0E25\u0E17\u0E34\u0E19
      (\u0E15\u0E31\u0E27\u0E40\u0E25\u0E02\u0E21\u0E38\u0E21\u0E0B\u0E49\u0E32\u0E22\u0E1A\u0E19\u0E02\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E21\u0E19\u0E15\u0E4C\u0E14\u0E33) "
  backfire:
    title: "\u0E04\u0E33\u0E2A\u0E32\u0E1B\u0E22\u0E49\u0E2D\u0E19!"
    body: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E21\u0E25\u0E17\u0E34\u0E19\u0E40\u0E15\u0E47\u0E21
      \u0E08\u0E30\u0E40\u0E2A\u0E35\u0E22\u0E40\u0E2A\u0E35\u0E22\u0E02\u0E27\u0E31\u0E0D
      {khwanLoss}\n\u0E16\u0E49\u0E32\u0E02\u0E27\u0E31\u0E0D\u0E40\u0E2B\u0E25\u0E37\u0E2D
      1 \u0E41\u0E25\u0E49\u0E27\u0E21\u0E25\u0E17\u0E34\u0E19\u0E40\u0E15\u0E47\u0E21\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07
      \u0E08\u0E30\u0E41\u0E1E\u0E49\u0E17\u0E31\u0E19\u0E17\u0E35"
  won:
    title: "\u0E0A\u0E19\u0E30\u0E1D\u0E31\u0E19\u0E23\u0E49\u0E32\u0E22"
    body: "\u0E40\u0E07\u0E32\u0E14\u0E33\u0E2A\u0E25\u0E32\u0E22\u0E44\u0E1B...
      \u0E02\u0E27\u0E31\u0E0D\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E30\u0E15\u0E37\u0E48\u0E19\u0E08\u0E32\u0E01\u0E1D\u0E31\u0E19"
  lost:
    title: "\u0E02\u0E27\u0E31\u0E0D\u0E1E\u0E48\u0E32\u0E22\u0E41\u0E1E\u0E49\u0E43\u0E2B\u0E49\u0E01\u0E31\u0E1A\u0E40\u0E07\u0E32\u0E14\u0E33"
    body: "\u0E02\u0E27\u0E31\u0E0D\u0E16\u0E39\u0E01\u0E40\u0E07\u0E32\u0E14\u0E33\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E08\u0E39\u0E48\u0E42\u0E08\u0E21
