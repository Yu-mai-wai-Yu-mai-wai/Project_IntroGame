  pages:
  - backgroundVideo: {fileID: 32900000, guid: 308583065f597574380fb2f5804befa7, type: 3}
    background: {fileID: 0}
    blackScreen: 0
    speaker: 
    text: "\u0E02\u0E27\u0E31\u0E0D \u0E19\u0E31\u0E01\u0E28\u0E36\u0E01\u0E29\u0E32\u0E0A\u0E32\u0E22
      \u0E2D\u0E32\u0E22\u0E38 18 \u0E1B\u0E35 \u0E02\u0E27\u0E31\u0E0D\u0E40\u0E01\u0E34\u0E14\u0E41\u0E25\u0E30\u0E42\u0E15\u0E21\u0E32\u0E01\u0E31\u0E1A\u0E1E\u0E48\u0E2D\u0E41\u0E21\u0E48\u0E17\u0E35\u0E48\u0E2D\u0E35\u0E2A\u0E32\u0E19"
    tutorialFightEnemy: {fileID: 0}
  - backgroundVideo: {fileID: 0}
    background: {fileID: 0}
    blackScreen: 0
    speaker: 
    text: "\u0E1E\u0E48\u0E2D\u0E02\u0E2D\u0E07\u0E02\u0E27\u0E31\u0E0D\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E21\u0E2D\u0E18\u0E23\u0E23\u0E21\u0E21\u0E32\u0E01\u0E1D\u0E35\u0E21\u0E37\u0E2D
      \u0E17\u0E35\u0E48\u0E04\u0E2D\u0E22\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E1C\u0E39\u0E49\u0E04\u0E19\u0E20\u0E32\u0E22\u0E43\u0E19\u0E2B\u0E21\u0E39\u0E48\u0E1A\u0E49\u0E32\u0E19"
    tutorialFightEnemy: {fileID: 0}
  - backgroundVideo: {fileID: 0}
    background: {fileID: 0}
    blackScreen: 0
    speaker: 
    text: "\u0E41\u0E15\u0E48\u0E02\u0E27\u0E31\u0E0D\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E21\u0E31\u0E19\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E07\u0E21\u0E07\u0E32\u0E22
      \u0E08\u0E36\u0E07\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2A\u0E19\u0E43\u0E08\u0E2A\u0E32\u0E19\u0E15\u0E48\u0E2D\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E1E\u0E48\u0E2D\u0E17\u0E33
      \u0E41\u0E25\u0E30\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E21\u0E32\u0E40\u0E23\u0E35\u0E22\u0E19\u0E15\u0E48\u0E2D\u0E43\u0E19\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E41\u0E17\u0E19"
    tutorialFightEnemy: {fileID: 0}
  - backgroundVideo: {fileID: 0}
    background: {fileID: 21300000, guid: d232ea2729360ad48af0459a79ed623d, type: 3}
    blackScreen: 0
    speaker: 
    text: "\u0E04\u0E37\u0E19\u0E2B\u0E19\u0E36\u0E48\u0E07... \u0E43\u0E19\u0E02\u0E13\u0E30\u0E17\u0E35\u0E48\u0E02\u0E27\u0E31\u0E0D\u0E2B\u0E25\u0E31\u0E1A"
    tutorialFightEnemy: {fileID: 0}
  - backgroundVideo: {fileID: 0}
    background: {fileID: 21300000, guid: d232ea2729360ad48af0459a79ed623d, type: 3}
    blackScreen: 0
    speaker: 
    text: "\u0E02\u0E27\u0E31\u0E0D\u0E1D\u0E31\u0E19\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E07\u0E32\u0E14\u0E33\u0E21\u0E32\u0E01\u0E21\u0E32\u0E22\u0E01\u0E33\u0E25\u0E31\u0E07\u0E1A\u0E38\u0E01\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E1A\u0E49\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E40\u0E02\u0E32
